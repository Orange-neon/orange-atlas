---
import AuthNav from "../../components/AuthNav.astro";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const iconHref = `${basePath}assets/orangeAtlas.png`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AP World History vocabulary, reading, and historical-reasoning practice tests on Orange Atlas." />
    <title>AP World History Practice Hub | Orange Atlas</title>
    <link rel="icon" href={iconHref} type="image/png" />
    <link rel="apple-touch-icon" href={iconHref} />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,700&display=swap");

      :root {
        --bg: #080706;
        --panel: #12100d;
        --panel-soft: #18140f;
        --line: rgba(248, 210, 148, 0.16);
        --line-strong: rgba(232, 151, 67, 0.48);
        --text: #f7f1e7;
        --muted: #b8aa97;
        --gold: #e89743;
        --gold-light: #ffd59a;
        --blue: #76b7c7;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        min-height: 100vh;
        color: var(--text);
        font-family: "DM Sans", sans-serif;
        background:
          radial-gradient(circle at 12% 4%, rgba(232, 151, 67, 0.15), transparent 28rem),
          radial-gradient(circle at 90% 23%, rgba(118, 183, 199, 0.09), transparent 25rem),
          linear-gradient(180deg, #050403, var(--bg) 42%, #0d0a07);
        padding: 0 1rem 4rem;
      }

      .site-nav, .wrap { width: min(1120px, 100%); margin: 0 auto; }
      .site-nav {
        min-height: 4.8rem; display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; border-bottom: 1px solid var(--line); padding-right: 17rem;
      }
      .brand, .all-courses { color: inherit; text-decoration: none; font-weight: 700; }
      .brand { display: inline-flex; align-items: center; gap: .7rem; }
      .brand img { width: 2.35rem; height: 2.35rem; border-radius: .5rem; object-fit: cover; }
      .brand span { color: var(--gold-light); }
      .all-courses {
        border: 1px solid var(--line); border-radius: .45rem; padding: .65rem .85rem;
        color: var(--muted); background: rgba(255,255,255,.025);
      }
      .all-courses:hover { border-color: var(--line-strong); color: var(--text); }

      .hero { padding: clamp(4rem, 9vw, 7.5rem) 0 3.5rem; max-width: 860px; }
      .eyebrow {
        color: var(--gold); font-size: .69rem; font-weight: 700; letter-spacing: .22em;
        text-transform: uppercase; margin-bottom: 1rem;
      }
      h1, h2, h3 { font-family: "Newsreader", Georgia, serif; }
      h1 { font-size: clamp(3.2rem, 9vw, 6.4rem); line-height: .92; letter-spacing: -.035em; }
      h1 em { color: var(--gold-light); font-style: italic; font-weight: 500; }
      .hero-copy { max-width: 680px; margin-top: 1.35rem; color: var(--muted); font-size: 1.06rem; line-height: 1.78; }
      .stats { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }
      .stat {
        min-width: 9.2rem; border-left: 2px solid var(--gold); padding: .25rem .9rem;
      }
      .stat strong { display: block; color: var(--text); font-family: "Newsreader", serif; font-size: 1.55rem; }
      .stat span { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .09em; }

      .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 1rem 0 1.1rem; }
      .test-section + .test-section { margin-top: 3.2rem; padding-top: 2.8rem; border-top: 1px solid var(--line); }
      h2 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1; }
      .section-head p { color: var(--muted); max-width: 38rem; line-height: 1.65; font-size: .9rem; }
      .test-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: .85rem; }
      .test-card {
        min-height: 12rem; display: flex; flex-direction: column; color: inherit; text-decoration: none;
        border: 1px solid var(--line); border-radius: .55rem; padding: 1.1rem;
        background: linear-gradient(145deg, rgba(28,23,17,.9), rgba(13,11,9,.94));
        transition: transform .18s, border-color .18s, background .18s;
      }
      .test-card:hover { transform: translateY(-3px); border-color: var(--line-strong); background: linear-gradient(145deg, rgba(46,33,20,.95), rgba(17,13,10,.98)); }
      .test-number { color: var(--gold); font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; }
      h3 { font-size: 1.48rem; margin: .55rem 0 .45rem; }
      .test-card p { color: var(--muted); font-size: .84rem; line-height: 1.55; flex: 1; }
      .test-meta { color: var(--gold-light); font-size: .72rem; margin-top: .9rem; text-transform: uppercase; letter-spacing: .08em; }

      @media (max-width: 900px) {
        .site-nav { align-items: flex-start; flex-direction: column; padding: 4.5rem 0 1rem; }
        .all-courses { width: 100%; text-align: center; }
        .hero { padding-top: 3rem; }
        .section-head { align-items: flex-start; flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <AuthNav showAiChat={false} analyticsCourse="AP World History" />

    <nav class="site-nav" aria-label="Course navigation">
      <a class="brand" href={basePath} aria-label="Orange Atlas home">
        <img src={iconHref} alt="" />
        <span>Orange Atlas</span>
      </a>
      <a class="all-courses" href={`${basePath}#subjects`}>All Courses</a>
    </nav>

    <main class="wrap">
      <header class="hero">
        <p class="eyebrow">Course Hub · Chapters 1–2</p>
        <h1>AP World<br /><em>History</em></h1>
        <p class="hero-copy">
          Build fast recall, verify close reading, and practice the historical reasoning needed to compare societies and explain change across the foundations of world history.
        </p>
        <div class="stats" aria-label="Test set statistics">
          <div class="stat"><strong>17</strong><span>practice tests</span></div>
          <div class="stat"><strong>210</strong><span>total questions</span></div>
          <div class="stat"><strong>2</strong><span>chapters covered</span></div>
          <div class="stat"><strong>3</strong><span>test formats</span></div>
        </div>
      </header>

      <section class="test-section" aria-labelledby="tests-heading">
        <div class="section-head">
          <h2 id="tests-heading">Vocabulary &amp; Geography Tests</h2>
          <p>Each numbered test draws ten questions from the complete bank. Questions move forward only and submit automatically at five minutes.</p>
        </div>
        <div class="test-grid">
          {Array.from({ length: 7 }, (_, index) => (
            <a class="test-card" href={`${basePath}tests/ap-world-vocab-${index + 1}/`}>
              <span class="test-number">Practice set {String(index + 1).padStart(2, "0")}</span>
              <h3>Vocabulary Test {index + 1}</h3>
              <p>Identify the vocabulary or geography term from its definition without an on-screen word bank.</p>
              <span class="test-meta">10 questions · 5 minutes →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="test-section" aria-labelledby="reading-heading">
        <div class="section-head">
          <h2 id="reading-heading">Cumulative Chapter Reading Tests</h2>
          <p>Six distinct, self-contained tests that each draw across Chapters 1 and 2 without dividing questions into topic sections.</p>
        </div>
        <div class="test-grid">
          {Array.from({ length: 6 }, (_, index) => (
            <a class="test-card" href={`${basePath}tests/ap-world-reading-${index + 1}/`}>
              <span class="test-number">Chapters 1–2 · Set {String(index + 1).padStart(2, "0")}</span>
              <h3>Cumulative Reading Test {index + 1}</h3>
              <p>Use a unique set of questions spanning both chapters to separate a nearly right answer from the fully accurate one.</p>
              <span class="test-meta">10 questions · 5 minutes →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="test-section" aria-labelledby="review-heading">
        <div class="section-head">
          <h2 id="review-heading">Chapters 1–2 Content Review</h2>
          <p>Four distinct, self-contained cumulative reviews. Every test spans the full Chapters 1–2 content instead of covering one regional section.</p>
        </div>
        <div class="test-grid">
          {[
            {
              href: "ap-world-ch1-2-review",
              level: "Cumulative Review · Set 01",
              title: "Chapters 1–2 Test 1",
              description: "A unique twenty-question test moving throughout the foundations, traditions, networks, and regional worlds in both chapters.",
            },
            {
              href: "ap-world-ch1-2-review-2",
              level: "Cumulative Review · Set 02",
              title: "Chapters 1–2 Test 2",
              description: "A second complete Chapters 1–2 assessment with twenty different questions and no topic sections.",
            },
            {
              href: "ap-world-ch1-2-review-3",
              level: "Cumulative Review · Set 03",
              title: "Chapters 1–2 Test 3",
              description: "A third independent cumulative assessment drawing new questions from the full two-chapter scope.",
            },
            {
              href: "ap-world-ch1-2-review-4",
              level: "Cumulative Review · Set 04",
              title: "Chapters 1–2 Test 4",
              description: "A fourth complete and distinct test of people, places, institutions, technologies, and comparisons across both chapters.",
            },
          ].map((review) => (
            <a class="test-card" href={`${basePath}tests/${review.href}/`}>
              <span class="test-number">{review.level}</span>
              <h3>{review.title}</h3>
              <p>{review.description}</p>
              <span class="test-meta">20 questions · 15 minutes →</span>
            </a>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

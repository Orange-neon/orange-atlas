---
import AuthNav from "../../components/AuthNav.astro";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const iconHref = `${basePath}assets/orangeAtlas.png`;
const firstTestHref = `${basePath}tests/la-naturaleza-1/`;
const secondTestHref = `${basePath}tests/la-naturaleza-2/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Spanish 3 vocabulary and subjunctive practice tests on Orange Atlas." />
    <title>Spanish 3 | Orange Atlas</title>
    <link rel="icon" href={iconHref} type="image/png" />
    <link rel="apple-touch-icon" href={iconHref} />
    <style>
      :root {
        color-scheme: dark;
        --bg: #070b12;
        --panel: #121b29;
        --panel-2: #162435;
        --line: rgba(154, 218, 190, 0.22);
        --text: #edf8f2;
        --muted: #a5bdb2;
        --green: #6ee7b7;
        --gold: #ffc477;
      }
      * { box-sizing: border-box; }
      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        color: var(--text);
        background:
          radial-gradient(circle at 12% 8%, rgba(52, 211, 153, .16), transparent 28rem),
          radial-gradient(circle at 88% 18%, rgba(255, 196, 119, .12), transparent 25rem),
          linear-gradient(180deg, #05080d, var(--bg));
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        line-height: 1.6;
      }
      a { color: inherit; }
      .nav, main { width: min(100% - 2rem, 980px); margin-inline: auto; }
      .nav { display: flex; align-items: center; justify-content: space-between; min-height: 5rem; }
      .brand { display: inline-flex; align-items: center; gap: .7rem; font-weight: 800; text-decoration: none; }
      .brand img { width: 2rem; height: 2rem; object-fit: contain; }
      .all-courses { color: var(--muted); font-size: .88rem; font-weight: 700; }
      main { padding: 3.5rem 0 5rem; }
      .eyebrow { margin: 0 0 .65rem; color: var(--green); font-size: .72rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
      h1, h2, h3, p { margin-top: 0; }
      h1 { max-width: 12ch; margin-bottom: 1rem; font-family: Georgia, serif; font-size: clamp(3rem, 9vw, 6.8rem); line-height: .92; letter-spacing: -.055em; }
      h1 span { color: var(--green); }
      .intro { max-width: 58ch; color: var(--muted); font-size: 1.05rem; }
      .stats { display: flex; flex-wrap: wrap; gap: .65rem; margin: 2rem 0 3.5rem; }
      .stat { min-width: 8.5rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: .65rem; background: rgba(18, 27, 41, .76); }
      .stat strong { display: block; color: var(--green); font-size: 1.3rem; }
      .stat span { color: var(--muted); font-size: .76rem; }
      h2 { margin-bottom: 1rem; font-family: Georgia, serif; font-size: 1.8rem; }
      .unit { padding: clamp(1.2rem, 4vw, 2rem); border: 1px solid var(--line); border-radius: 1rem; background: linear-gradient(145deg, var(--panel), var(--panel-2)); box-shadow: 0 24px 60px rgba(0,0,0,.3); }
      .chip { display: inline-block; margin-bottom: .8rem; padding: .2rem .6rem; border: 1px solid rgba(110,231,183,.32); border-radius: 999px; color: var(--green); background: rgba(110,231,183,.08); font-size: .67rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
      .unit h3 { margin-bottom: .55rem; font-family: Georgia, serif; font-size: 1.55rem; }
      .unit > p { color: var(--muted); }
      .test-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; margin-top: 1.5rem; }
      .test { display: block; padding: 1.15rem; border: 1px solid rgba(255,196,119,.28); border-radius: .75rem; background: rgba(5,8,13,.48); text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
      .test:hover { transform: translateY(-3px); border-color: var(--gold); }
      .test strong { display: block; margin-bottom: .35rem; color: #fff; font-size: 1.05rem; }
      .test span { color: var(--muted); font-size: .9rem; }
      .open { display: block; margin-top: .8rem; color: var(--gold) !important; font-weight: 800; }
      @media (max-width: 680px) { .test-list { grid-template-columns: 1fr; } }
      @media (max-width: 560px) { main { padding-top: 2rem; } .stats { display: grid; grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <AuthNav showAiChat={false} analyticsCourse="Spanish 3" />
    <nav class="nav" aria-label="Course navigation">
      <a class="brand" href={basePath} aria-label="Orange Atlas home"><img src={iconHref} alt="" /> Orange Atlas</a>
      <a class="all-courses" href={`${basePath}#subjects`}>All courses</a>
    </nav>
    <main>
      <p class="eyebrow">Course home</p>
      <h1><span>Spanish 3</span> Practice Hub</h1>
      <p class="intro">Practice unit vocabulary and the present subjunctive with timed tests, detailed feedback, and results by topic.</p>
      <div class="stats" aria-label="Course statistics">
        <div class="stat"><strong>1</strong><span>active unit</span></div>
        <div class="stat"><strong>2</strong><span>available tests</span></div>
        <div class="stat"><strong>48</strong><span>total questions</span></div>
      </div>
      <h2>Units</h2>
      <section class="unit" aria-labelledby="naturaleza-title">
        <span class="chip">Active unit</span>
        <h3 id="naturaleza-title">Unit 1 · La Naturaleza</h3>
        <p>Nature vocabulary, precise definitions, and subjunctive usage and formation. Both tests include odd-one-out questions, sentence completion, and short written answers.</p>
        <div class="test-list">
          <a class="test" href={firstTestHref}>
            <strong>La Naturaleza 1</strong>
            <span>Hard practice: 24 questions, with 12 multiple-choice and 12 short-answer questions.</span>
            <span class="open">Start test →</span>
          </a>
          <a class="test" href={secondTestHref}>
            <strong>La Naturaleza 2 · Hard</strong>
            <span>Hard practice: 24 new questions testing vocabulary distinctions and subjunctive application.</span>
            <span class="open">Start test →</span>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
